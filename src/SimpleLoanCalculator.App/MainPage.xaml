<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SimpleLoanCalculator_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SimpleLoanCalculator_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton
                x:Uid="CalculateCommand"
                AutomationProperties.Name="Calculate loan"
                Click="Calculate_Click"
                Icon="Calculator"
                Label="Calculate" />
            <AppBarButton
                x:Uid="CopyScheduleCommand"
                AutomationProperties.Name="Copy amortization schedule as CSV"
                Click="CopySchedule_Click"
                Icon="Copy"
                IsEnabled="False"
                Label="Copy schedule"
                x:Name="CopyScheduleButton" />
            <AppBarButton
                x:Uid="ResetCommand"
                AutomationProperties.Name="Reset calculator"
                Click="Reset_Click"
                Icon="Refresh"
                Label="Reset" />
        </CommandBar>

        <ScrollViewer Grid.Row="1">
            <Grid
                x:Name="ContentGrid"
                MaxWidth="1480"
                Padding="32,24,32,40"
                ColumnSpacing="28"
                RowSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InputsColumn" Width="*" />
                    <ColumnDefinition x:Name="ResultsColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Narrow" />
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="980" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="InputsColumn.Width" Value="5*" />
                                <Setter Target="ResultsColumn.Width" Value="7*" />
                                <Setter Target="ResultsPanel.(Grid.Column)" Value="1" />
                                <Setter Target="ResultsPanel.(Grid.Row)" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <StackPanel x:Name="InputsPanel" Spacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="LoanWorksheetHeading" Style="{StaticResource TitleTextBlockStyle}" Text="Loan worksheet" />
                    </StackPanel>

                    <InfoBar
                        x:Name="StatusInfoBar"
                        IsClosable="True"
                        IsOpen="False" />

                    <Grid ColumnSpacing="16" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            x:Name="PrincipalTextBox"
                            x:Uid="PrincipalInput"
                            AutomationProperties.HelpText="Enter any positive base-10 amount without an exponent."
                            Header="Amount financed"
                            InputScope="Number"
                            Text="250000" />
                        <TextBox
                            x:Name="AnnualRateTextBox"
                            x:Uid="AnnualRateInput"
                            Grid.Column="1"
                            AutomationProperties.HelpText="Nominal annual percentage rate."
                            Header="Annual rate (%)"
                            InputScope="Number"
                            Text="6.5" />
                        <TextBox
                            x:Name="NumberOfPaymentsTextBox"
                            x:Uid="NumberOfPaymentsInput"
                            Grid.Row="1"
                            Header="Number of payments"
                            InputScope="Number"
                            Text="360" />
                        <TextBox
                            x:Name="PaymentsPerYearTextBox"
                            x:Uid="PaymentsPerYearInput"
                            Grid.Row="1"
                            Grid.Column="1"
                            Header="Payments per year"
                            InputScope="Number"
                            Text="12" />
                        <ComboBox
                            x:Name="PaymentTimingComboBox"
                            x:Uid="PaymentTimingInput"
                            Grid.Row="2"
                            Header="Payment timing"
                            SelectedIndex="0">
                            <ComboBoxItem x:Uid="EndOfPeriodOption" Content="End of period" Tag="EndOfPeriod" />
                            <ComboBoxItem x:Uid="BeginningOfPeriodOption" Content="Beginning of period" Tag="BeginningOfPeriod" />
                        </ComboBox>
                        <ComboBox
                            x:Name="SolveTargetComboBox"
                            x:Uid="SolveTargetInput"
                            Grid.Row="2"
                            Grid.Column="1"
                            Header="Solve for"
                            SelectionChanged="SolveTarget_SelectionChanged"
                            SelectedIndex="0">
                            <ComboBoxItem x:Uid="PeriodicPaymentOption" Content="Periodic payment" Tag="PeriodicPayment" />
                            <ComboBoxItem x:Uid="PrincipalOption" Content="Amount financed" Tag="Principal" />
                            <ComboBoxItem x:Uid="AnnualRateOption" Content="Annual rate" Tag="AnnualRate" />
                            <ComboBoxItem x:Uid="NumberOfPaymentsOption" Content="Number of payments" Tag="NumberOfPayments" />
                        </ComboBox>
                        <TextBox
                            x:Name="KnownPaymentTextBox"
                            x:Uid="KnownPaymentInput"
                            Grid.Row="3"
                            Header="Known periodic payment"
                            InputScope="Number"
                            IsEnabled="False"
                            PlaceholderText="Used by reverse calculations" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <TextBox
                                x:Name="MonetaryUnitTextBox"
                                x:Uid="MonetaryUnitInput"
                                Width="130"
                                Header="Monetary unit"
                                MaxLength="24"
                                Text="USD" />
                            <TextBox
                                x:Name="DisplayScaleTextBox"
                                x:Uid="DisplayScaleInput"
                                Width="130"
                                Header="Decimal places"
                                InputScope="Number"
                                Text="2" />
                        </StackPanel>
                    </Grid>

                    <Button
                        x:Name="CalculateButton"
                        x:Uid="CalculateButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Calculate loan result"
                        Click="Calculate_Click"
                        Content="Calculate"
                        Style="{StaticResource AccentButtonStyle}" />

                    <Expander x:Uid="PurchaseWorksheet" Header="Purchase and trade-in worksheet">
                        <StackPanel Padding="0,14,0,2" Spacing="14">
                            <TextBlock
                                x:Uid="PurchaseFormula"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Amount financed = sale price − trade-in + trade-in payoff − down payment."
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="SalePriceTextBox" x:Uid="SalePriceInput" Header="Sale price" InputScope="Number" />
                                <TextBox x:Name="TradeInTextBox" x:Uid="TradeInInput" Grid.Column="1" Header="Trade-in value" InputScope="Number" />
                                <TextBox x:Name="TradeInPayoffTextBox" x:Uid="TradeInPayoffInput" Grid.Row="1" Header="Trade-in payoff" InputScope="Number" />
                                <TextBox x:Name="DownPaymentTextBox" x:Uid="DownPaymentInput" Grid.Row="1" Grid.Column="1" Header="Down payment" InputScope="Number" />
                            </Grid>
                            <Button
                                x:Uid="UseAmountFinancedButton"
                                HorizontalAlignment="Left"
                                Click="UseAmountFinanced_Click"
                                Content="Use calculated amount financed" />
                        </StackPanel>
                    </Expander>

                    <TextBlock
                        x:Uid="EstimateDisclaimer"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Results are estimates, not lending, legal, accounting, or financial advice. Confirm lender conventions, fees, compounding, and final-payment adjustments."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    x:Name="ResultsPanel"
                    Grid.Row="1"
                    Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="ResultsHeading" Style="{StaticResource TitleTextBlockStyle}" Text="Results" />
                        <TextBlock
                            x:Name="ResultDescriptionTextBlock"
                            x:Uid="ResultsPrompt"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Calculate a loan to see its payment and amortization schedule."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="PeriodicPaymentHeading" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Periodic payment" />
                            <TextBlock x:Name="PaymentResultTextBlock" FontSize="24" FontWeight="SemiBold" Text="—" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Uid="TotalPaidHeading" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Total paid" />
                            <TextBlock x:Name="TotalPaidResultTextBlock" FontSize="20" FontWeight="SemiBold" Text="—" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock x:Uid="TotalInterestHeading" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Total interest" />
                            <TextBlock x:Name="TotalInterestResultTextBlock" FontSize="20" FontWeight="SemiBold" Text="—" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Uid="ScheduleHeading" Style="{StaticResource SubtitleTextBlockStyle}" Text="Amortization schedule" />
                    <Grid ColumnSpacing="10" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="PeriodColumn" FontWeight="SemiBold" Text="Period" />
                        <TextBlock x:Uid="PaymentColumn" Grid.Column="1" FontWeight="SemiBold" Text="Payment" />
                        <TextBlock x:Uid="PrincipalColumn" Grid.Column="2" FontWeight="SemiBold" Text="Principal" />
                        <TextBlock x:Uid="InterestColumn" Grid.Column="3" FontWeight="SemiBold" Text="Interest" />
                        <TextBlock x:Uid="BalanceColumn" Grid.Column="4" FontWeight="SemiBold" Text="Balance" />
                    </Grid>
                    <ListView
                        x:Name="ScheduleListView"
                        Height="520"
                        AutomationProperties.Name="Amortization schedule"
                        ItemsSource="{x:Bind ScheduleRows}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ScheduleRowView">
                                <Grid ColumnSpacing="10" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Period}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Payment}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Principal}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Interest}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Balance}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
